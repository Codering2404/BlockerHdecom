    <string name="info_accountability_partner">Adds an accountability or parental control layer. Depending on the selected type, disabling features may require approval, a waiting period, or completing a challenge.&lt;br&gt;&lt;br&gt;%1$s</string>
    <string name="info_block_adult_content">When &lt;b&gt;enabled&lt;/b&gt;, you won\'t be able to access adult content on Supported Browsers and popular social media apps. (also this feature will automatically filter out adult content from search results in Supported Browsers)&lt;br&gt;&lt;br&gt;&lt;b&gt;Supported browsers:&lt;/b&gt;&lt;br&gt; %1$s.</string>
    <string name="info_block_img_vid_search">When &lt;b&gt;enabled&lt;/b&gt;, image and video searches on browsers will be blocked. (Works only on supported browsers)</string>
    <string name="info_block_insta_reels">When &lt;b&gt;enabled&lt;/b&gt;, %1$s Reels video will be blocked.</string>
    <string name="info_block_insta_search">When &lt;b&gt;enabled&lt;/b&gt;, Instagram &lt;b&gt;search bar&lt;/b&gt; will be blocked.</string>
    <string name="info_block_newly_installed_apps">When &lt;b&gt;enabled&lt;/b&gt;, all &lt;b&gt;newly installed&lt;/b&gt; apps will automatically be added to your blocklist.</string>
    <string name="info_block_snapchat_stories">When &lt;b&gt;enabled&lt;/b&gt;, Snapchat &lt;b&gt;stories and spotlight&lt;/b&gt; section will be blocked.</string>
    <string name="info_block_telegram_search">When &lt;b&gt;enabled&lt;/b&gt;, Telegram &lt;b&gt;search bar&lt;/b&gt; will be blocked.</string>
    <string name="info_block_unsupported_browsers">When &lt;b&gt;enabled&lt;/b&gt;, all other browsers will be blocked except the supported browsers.&lt;br&gt;&lt;br&gt;&lt;b&gt;Supported browsers:&lt;/b&gt;&lt;br&gt; %1$s.</string>
    <string name="info_block_whatsapp_channels">When &lt;b&gt;enabled&lt;/b&gt;, you won\'t be able to access the `Explore channels` section in WhatsApp, You can still view channels you already follow, but you won’t be able to search for or follow new ones.</string>
    <string name="info_block_youtube_shorts">When &lt;b&gt;enabled&lt;/b&gt;, you won\'t be able to watch &lt;b&gt;YouTube Shorts&lt;/b&gt; on YouTube app YouTube website.</string>
    <string name="info_custom_block_screen_countdown">Set a &lt;b&gt;Custom countdown&lt;/b&gt; for the &lt;b&gt;blocked screen&lt;/b&gt; (default is 3 seconds).</string>
    <string name="info_custom_block_screen_message">This message will be shown at the top of the &lt;b&gt;blocked screen&lt;/b&gt;.</string>
    <string name="info_custom_block_screen_redirect_url">Clicking &lt;b&gt;CLOSE&lt;/b&gt; on the blocked screen will redirect you to this URL. (This will not work during active Focus Mode )</string>
    <string name="info_filter_search_results">When &lt;b&gt;enabled&lt;/b&gt;, you will not see adult content search results on the browser.</string>
    <string name="info_uninstall_protection">When &lt;b&gt;enabled&lt;/b&gt;, this prevents uninstalling this app and changing its related settings unless approved by your Accountability Partner. &lt;br&gt;&lt;br&gt;Note: No technology is 100% perfect, uninstall protection is just one tool to support you in managing compulsive porn usage. This requires Device Admin app permission.</string>
